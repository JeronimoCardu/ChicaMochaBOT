# Consegui estos valores en: Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Habilitar Realtime en Supabase: Database → Replication → supabase_realtime → pedidos
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# WhatsApp Cloud API — necesario para notificaciones de cancelación desde el dashboard
# Obtené estos valores de: Meta for Developers → tu app → WhatsApp → API Setup
WHATSAPP_TOKEN=tu-whatsapp-token
PHONE_NUMBER_ID=tu-phone-number-id
